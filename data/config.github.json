    "twitter": {
      "enabled": false,
      "mode": "playwright",
      "users": [],
      "keywords": [],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5,
      "category": "ai-tools",
      "profile": "tech-news",
      "cookie_dir": "data",
      "cookie_file_pattern": "x_cookies_*.json"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 25,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "group_by": "category",
    "category_groups": {
      "01-intel": {
        "name": "01-情报",
        "limit": 10,
        "categories": [
          "intel-world",
          "intel-macro"
        ]
      },
      "02-product": {
        "name": "02-产品",
        "limit": 6,
        "categories": [
          "product-startup"
        ]
      },
      "03-invest": {
        "name": "03-投资",
        "limit": 4,
        "categories": [
          "invest-market"
        ]
      },
      "04-ai": {
        "name": "04-AI",
        "limit": 10,
        "categories": [
          "ai-tools"
        ]
      },
      "05-misc": {
        "name": "05-杂项",
        "limit": 4,
        "categories": [
          "misc"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
